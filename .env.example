# Copy to apps/web/.env.local (web) and apps/mobile/.env (mobile)
SUQA_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# web: tenant is resolved from the hostname; this is the dev fallback when host = localhost
NEXT_PUBLIC_SUQA_DEV_TENANT=batroun
# mobile: tenant is fixed per build
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUQA_TENANT_SLUG=batroun
